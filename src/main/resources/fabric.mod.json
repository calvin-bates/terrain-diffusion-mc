{
  "schemaVersion": 1,
  "id": "terra",
  "version": "${version}",
  "name": "Terra",
  "description": "Terra: realistic AI-generated terrain with a tall build height. Based on Terrain Diffusion by xandergos (MIT).",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/terra/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcDataGenerator"
    ],
    "client": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcClient"
    ],
    "main": [
      "com.github.xandergos.terraindiffusionmc.TerrainDiffusionMc"
    ]
  },
  "mixins": [
    "terra.mixins.json",
    {
      "config": "terra.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
