{
  "schemaVersion": 1,
  "id": "terra",
  "version": "${version}",
  "name": "Terra",
  "description": "A playable, realistic terrain generation mod built off of xandergos' Terrain Diffusion.",
  "authors": [
    "The_Ponderer",
    {
      "name": "xandergos",
      "contact": {
        "homepage": "https://github.com/xandergos/terrain-diffusion-mc"
      }
    }
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/terra/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcDataGenerator"
    ],
    "client": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcClient"
    ],
    "main": [
      "com.github.xandergos.terraindiffusionmc.TerrainDiffusionMc"
    ]
  },
  "mixins": [
    "terra.mixins.json",
    {
      "config": "terra.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
