{
  "schemaVersion": 1,
  "id": "orogeny",
  "version": "${version}",
  "name": "Orogeny",
  "description": "Realistic, AI-generated terrain: continents, mountain ranges, rivers, lakes, coasts, islands, caves and 85 new surface and cave biomes, built on xandergos' Terrain Diffusion.",
  "authors": [
    "The_Ponderer",
    {
      "name": "xandergos",
      "contact": {
        "homepage": "https://github.com/xandergos/terrain-diffusion-mc"
      }
    }
  ],
  "contact": {
    "homepage": "https://github.com/calvin-bates/terrain-diffusion-mc",
    "sources": "https://github.com/calvin-bates/terrain-diffusion-mc",
    "issues": "https://github.com/calvin-bates/terrain-diffusion-mc/issues"
  },
  "license": "MIT",
  "icon": "assets/orogeny/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcDataGenerator"
    ],
    "client": [
      "com.github.xandergos.terraindiffusionmc.client.TerrainDiffusionMcClient"
    ],
    "main": [
      "com.github.xandergos.terraindiffusionmc.TerrainDiffusionMc"
    ]
  },
  "mixins": [
    "orogeny.mixins.json",
    {
      "config": "orogeny.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  }
}
